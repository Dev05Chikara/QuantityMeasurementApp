{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "compare-route": {
        "ClusterId": "compare-cluster",
        "Match": {
          "Path": "/api/compare/{**catch-all}"
        }
      },
      "convert-route": {
        "ClusterId": "convert-cluster",
        "Match": {
          "Path": "/api/convert/{**catch-all}"
        }
      },
      "arithmetic-route": {
        "ClusterId": "arithmetic-cluster",
        "Match": {
          "Path": "/api/arithmetic/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "compare-cluster": {
        "Destinations": {
          "compare-destination": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "convert-cluster": {
        "Destinations": {
          "convert-destination": {
            "Address": "http://localhost:5003/"
          }
        }
      },
      "arithmetic-cluster": {
        "Destinations": {
          "arithmetic-destination": {
            "Address": "http://localhost:5004/"
          }
        }
      }
    }
  }
}
